TELEGRAM_BOT_TOKEN=
# Optional: Whisper transcription for Instagram/TikTok when captions are short
OPENAI_API_KEY=
# Apify token for video voiceover (Instagram/TikTok/YouTube actors)
APIFY_TOKEN=
# Channel @name or -100… id; bot must be admin. /post N publishes there.
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_SITE_URL=https://anpost.vercel.app
# Shared secret for /api/telegram/* on public deploy
ANPOST_OPERATOR_SECRET=
# Vercel Cron: Authorization Bearer CRON_SECRET (falls back to ANPOST_OPERATOR_SECRET)
CRON_SECRET=
# Optional public URL if the Next app is deployed
# ANPOST_URL=http://localhost:3000
